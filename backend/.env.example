# ─────────────────────────────────────────────────────────────
# TU Project Archive — Backend environment (EXAMPLE)
# Copy to `.env` and fill real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# CORS: the exact origin of the frontend (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Database
# DB_PROVIDER selects Prisma datasource + similarity backend.
#   sqlite      -> local/dev/demo, portable similarity engine
#   postgresql  -> production, pg_trgm-backed similarity
DB_PROVIDER=sqlite
# For sqlite:
DATABASE_URL="file:./dev.db"
# For postgresql (example):
# DATABASE_URL="postgresql://user:pass@host:5432/tu_archive?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=6h
COOKIE_NAME=tu_token
# Set true when served over HTTPS (production). false for local http.
COOKIE_SECURE=false

# Initial admin (seeded — never hardcoded in source)
SEED_ADMIN_EMAIL=admin@tu-archive.mm
SEED_ADMIN_PASSWORD="ChangeMe_Admin#2026"
SEED_ADMIN_NAME=Platform Admin

# Similarity thresholds (0..1)
SIMILARITY_EXACT_THRESHOLD=0.85
SIMILARITY_SIMILAR_THRESHOLD=0.30

# Uploads
UPLOAD_MAX_BYTES=26214400          # 25 MB
UPLOAD_ALLOWED_EXT=pdf,doc,docx,zip,jpg,jpeg,png
PRIVATE_STORAGE_DIR=./storage/private
PUBLIC_STORAGE_DIR=./storage/public

# Payments (manual MMK)
DEFAULT_PROJECT_PRICE_MMK=5000
PAYMENT_INSTRUCTIONS="Transfer to KBZPay 09-xxxxxxxxx (U Aung Aung) and upload the screenshot + txn id."

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000        # 15 min
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
